page {
  background: #f3f4f6;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.5;
}

.wrap {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #1e3a8a;
}

.hint {
  font-size: 24rpx;
  color: #6b7280;
}

.field {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.field-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #374151;
}

.field-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 10rpx;
  background: #f9fafb;
  font-size: 28rpx;
}

.field-unit {
  margin-left: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.row {
  display: flex;
  gap: 16rpx;
}

.row .field {
  flex: 1;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #3730a3;
  font-size: 24rpx;
}

.chip.active {
  background: #3730a3;
  color: #fff;
}

.seg {
  display: flex;
  border: 2rpx solid #3730a3;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  color: #3730a3;
  font-size: 26rpx;
}

.seg-item.active {
  background: #3730a3;
  color: #fff;
}

.btn {
  margin-top: 8rpx;
  background: #1e3a8a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.error {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 26rpx;
}

.tf {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 8rpx 0 16rpx;
  font-family: 'Times New Roman', serif;
  font-size: 30rpx;
}

.tf-line {
  align-self: stretch;
  display: flex;
  align-items: center;
}

.tf-name {
  margin-right: 12rpx;
  font-style: italic;
}

.tf-frac {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tf-num {
  padding: 0 12rpx 4rpx;
  word-break: break-all;
  text-align: center;
}

.tf-den {
  padding: 4rpx 12rpx 0;
  border-top: 2rpx solid #111827;
  word-break: break-all;
  text-align: center;
}

.kv {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.kv:last-child {
  border-bottom: none;
}

.kv-k {
  width: 260rpx;
  flex-shrink: 0;
  color: #6b7280;
}

.kv-v {
  flex: 1;
  word-break: break-all;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.grid-item {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.grid-box {
  background: #f9fafb;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
}

.grid-label {
  font-size: 22rpx;
  color: #6b7280;
}

.grid-value {
  font-size: 30rpx;
  font-weight: 600;
  word-break: break-all;
}

.tag {
  display: inline-block;
  padding: 2rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.tag.ok {
  background: #dcfce7;
  color: #15803d;
}

.tag.warn {
  background: #fef9c3;
  color: #a16207;
}

.tag.bad {
  background: #fee2e2;
  color: #b91c1c;
}

.note {
  font-size: 24rpx;
  color: #92400e;
  background: #fffbeb;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  margin-top: 12rpx;
}

.slider-row {
  display: flex;
  align-items: center;
}

.slider-row slider {
  flex: 1;
  margin: 0 12rpx 0 0;
}

.slider-name {
  width: 70rpx;
  font-weight: 600;
  font-style: italic;
}

.slider-input {
  width: 140rpx;
  height: 60rpx;
  padding: 0 12rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 8rpx;
  background: #f9fafb;
  text-align: center;
}

.plot-box {
  margin: 0 -8rpx;
}
