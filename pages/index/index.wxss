.hero {
  background: linear-gradient(135deg, #1e3a8a, #3730a3);
  color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.tools {
  margin-bottom: 24rpx;
}

.tool {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tool-hover {
  background: #eef2ff;
}

.tool-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background: #eef2ff;
  color: #3730a3;
  font-weight: 700;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.tool-body {
  flex: 1;
}

.tool-title {
  font-size: 32rpx;
  font-weight: 600;
}

.tool-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.tool-arrow {
  color: #9ca3af;
  font-size: 40rpx;
  margin-left: 12rpx;
}
