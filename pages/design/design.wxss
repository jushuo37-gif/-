.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.step-no {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #eef2ff;
  color: #3730a3;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.step-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: #374151;
  word-break: break-all;
}

.table {
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  overflow: hidden;
}

.tr {
  display: flex;
  border-bottom: 1rpx solid #e5e7eb;
}

.tr:last-child {
  border-bottom: none;
}

.th {
  background: #f3f4f6;
  font-weight: 600;
}

.td {
  flex: 1;
  padding: 12rpx;
  font-size: 24rpx;
  word-break: break-all;
}

.td.k {
  flex: 1.3;
  color: #374151;
}

.td.strong {
  color: #1e3a8a;
  font-weight: 600;
}
