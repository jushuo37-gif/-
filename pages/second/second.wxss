.table {
  margin-top: 16rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  overflow: hidden;
}

.tr {
  display: flex;
  border-bottom: 1rpx solid #e5e7eb;
}

.tr:last-child {
  border-bottom: none;
}

.th {
  background: #f3f4f6;
  font-weight: 600;
}

.td {
  flex: 1;
  padding: 12rpx;
  font-size: 24rpx;
  word-break: break-all;
}

.td.k {
  flex: 1.3;
  color: #374151;
}
